---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<p class="eyebrow">{text}</p>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }
</style>
